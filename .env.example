# Copie para .env e preencha. Em produção (Render), estas variáveis são
# configuradas no painel do serviço, não em arquivo.

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=seu-servico.onrender.com
CSRF_TRUSTED_ORIGINS=https://seu-servico.onrender.com

# Banco de dados — deixe DB_ENGINE em branco (ou omita) para usar SQLite local.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Storage — deixe STORAGE_BACKEND em branco (ou omita) para usar disco local.
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=auto
